# Conversaition - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# OpenAI Configuration (for Alice participant)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Configuration (for Bob participant)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google/Gemini Configuration (for Charlie participant)
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Custom model configurations
# OPENAI_MODEL=gpt-4
# ANTHROPIC_MODEL=claude-3-sonnet-20240229
# GEMINI_MODEL=gemini-pro
# ALICE_MODEL=gpt-o4-mini
# ALICE_TEMPERATURE=0.3
# ALICE_MAX_TOKENS=300
# BOB_MODEL=claude-sonnet-4-20250514
# BOB_TEMPERATURE=0.7
# CHARLIE_MODEL=gemini-2.5-pro
# CHARLIE_TEMPERATURE=0.8
# CHARLIE_MAX_TOKENS=400

# Development Settings
# DEBUG=true
# LOG_LEVEL=info

# Server Configuration
# BACKEND_HOST=localhost
# BACKEND_PORT=8000
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database Configuration (future use)
# DATABASE_URL=postgresql://user:password@localhost/conversaition
# REDIS_URL=redis://localhost:6379
